# ========================================================================
# bcs-solicitudes-api — Variables de entorno
# Copia este archivo como `.env` y completa los valores.
# ========================================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- MongoDB Atlas ---
# Connection string SRV de tu cluster M0 free.
# Formato: mongodb+srv://<user>:<password-url-encoded>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
# Ver docs/ATLAS-SETUP.md para guía paso a paso.
MONGODB_URI=mongodb+srv://bcs-app:CHANGE_ME@cluster0.xxxx.mongodb.net/bcs-solicitudes?retryWrites=true&w=majority
MONGODB_DB_NAME=bcs-solicitudes

# --- Mock Mulesoft / Core Banking ---
CORE_MOCK_URL=http://localhost:4001
CORE_BANKING_TIMEOUT_MS=5000
CORE_BANKING_MAX_RETRIES=3

# --- Auth ---
# JWT secret (HS256). Mínimo 32 caracteres en producción.
JWT_SECRET=dev-only-please-change-in-prod-32chars-min
JWT_EXPIRES_IN=15m

# --- CORS ---
# Lista separada por comas de orígenes permitidos.
CORS_ORIGINS=http://localhost:3001

# --- Observabilidad (opcional) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=bcs-solicitudes-api
